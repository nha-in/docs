# docs-mcp and indexer configuration. Everything here has a working default;
# the deploy pipeline sets EMBED_PROVIDER once per deployment and the indexer
# and server both read it, which keeps the snapshot and the server on the same
# model. Credentials are never configured here: the AWS SDK default chain
# resolves the task role in production, the OIDC-assumed role in CI, and your
# `aws configure` profile on a laptop.

# bedrock | ollama | none. REQUIRED for the server: leaving it unset fails
# startup, so a deployment that never decided fails its rollout. `none`
# serves keyword-only retrieval, deliberately. A configured provider is
# probed at startup and must answer one embedding, or startup fails.
EMBED_PROVIDER=none

# Provider model id. Defaults: amazon.titan-embed-text-v2:0 (bedrock),
# nomic-embed-text (ollama). Part of the index stamp: changing it means
# rebuilding catalogue.db.
#EMBED_MODEL=

# bedrock only. Empty lets the SDK resolve it.
#AWS_REGION=ap-south-1

# ollama only.
#OLLAMA_URL=http://localhost:11434

# Server.
#DB_PATH=catalogue.db
#ADDR=:8080
#ALLOW_ORIGIN=https://eka-care.github.io

# Indexer.
#CATALOGUE_DIR=../catalogue

# Public MCP endpoint the Ask AI assistant offers to readers who are
# building. Empty keeps the compiled default (the dev hostname).
MCP_URL=

# Sampling temperature for chat answers, 0 to 1. Empty takes 0.2.
CHAT_TEMPERATURE=
