# Dependencies
node_modules

# Docusaurus build outputs
site/build/
site/.docusaurus/

# Generated: specs are synced from catalogue/openapi by scripts/sync-specs.mjs
site/static/specs/

# Generated: Scalar browser bundle vendored by scripts/sync-specs.mjs
site/static/vendor/

# Generated: agent skills compiled from the pages by scripts/build-skills.mjs
site/static/skills/

# Generated: the support agent widget, bundled from widget/ on every build
site/static/agent/
widget/dist/

# Environment
.env
.env.*
# The example is documentation, not an environment.
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Local index snapshots (build outputs; CI produces its own)
mcp/catalogue.db
# The planning artifacts at the repo root only. A bare "docs" here would
# also ignore site/docs, which is the entire documentation content.
/docs/

# Generated: the API reference, built from catalogue/openapi by
# scripts/build-api-reference.mjs
site/docs/abdm/v3/api/*/endpoints/
site/docs/abdm/v3/api/index.md
site/docs/abdm/v3/api/*/errors.md
site/docs/abdm/v3/api/*/_servers.md
site/docs/abdm/v3/reference/authentication.md
site/docs/abdm/v3/reference/callbacks.md
site/docs/abdm/v3/reference/error-codes.md
site/src/data/api/
site/src/data/api-sidebar.json

# Generated: the skill manifest and the llms.txt index, written on every build
# by scripts/build-skills.mjs and scripts/build-nav.mjs.
site/src/data/skills.json
site/static/llms.txt
