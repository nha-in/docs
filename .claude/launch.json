{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-worktree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--workspace",
        "site"
      ],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "built-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
