{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-worktree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--workspace",
        "site"
      ],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "built-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve",
        "--workspace",
        "site"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "nha-pages",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/shyam/code/nha/docs/site && DOCUSAURUS_URL=https://nha-in.github.io DOCUSAURUS_BASE_URL=/docs/ npx docusaurus serve --dir build --port 3344 --no-open"
      ],
      "port": 3344
    }
  ]
}