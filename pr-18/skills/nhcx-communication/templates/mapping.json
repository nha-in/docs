      "table": "claim_payment",
      "columns": [
        "correlation_id",
        "ack_txn_id",
        "ack_status"
      ]
    }
  },
  "bundles": {
    "coverage": {
      "pin": "nhcx-package/fhir/B1",
      "elements": {
        "Patient.identifier[PMJAY]": "claim.member_id",
        "Coverage.identifier[NH]": "claim.policy_code",
        "Organization[prov].identifier[NPI]": "settings.hfr_id"
      }
    },
    "insurance": {
      "pin": "nhcx-package/fhir/B2/insurance-plan-request.json",
      "elements": {}
    },
    "claim": {
      "pin": "nhcx-package/fhir/B3/preauth-request.json",
      "elements": {
        "Practitioner.identifier[HPIN]": "<practitioner table>.hpin",
        "Claim.item[].productOrService": "claim_line.code (from claim_plan_benefit)",
        "Claim.insurance[0].preAuthRef": "claim_preauth.preauth_ref"
      }
    },
    "task": {
      "pin": "nhcx-package/fhir/B3/preauth-cancel.json",
      "elements": {}
    },
    "communication": {
      "pin": "nhcx-package/fhir/B4/communication-response.json",
      "elements": {}
    },
    "payment_ack": {
      "pin": "nhcx-package/fhir/B7/payment-notice-ack.json",
      "elements": {}
    }
  },
  "inbound": {
    "match_order": [
      "correlation_id",
      "claim_number",
      "unmatched"
    ],
    "dedupe_key": "x-hcx-api_call_id",
    "archive": "<cases dir>/<claim_no>/NNN-<usecase>-<direction>.json"
  },
