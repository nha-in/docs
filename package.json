{
  "name": "abdm-docs",
  "version": "0.1.0",
  "private": true,
  "description": "ABDM Developer Portal: catalogue of the HIE-CM gateway plus the Docusaurus and Scalar documentation site",
  "license": "MIT",
  "workspaces": [
    "site",
    "widget"
  ],
  "scripts": {
    "sync-specs": "node scripts/sync-specs.mjs",
    "lint:specs": "spectral lint \"catalogue/openapi/*/*/*.yaml\" --fail-severity=error",
    "start": "npm start --workspace site",
    "build": "npm run build --workspace site",
    "lint:atoms": "node scripts/lint-atoms.mjs",
    "lint:sources": "node scripts/check-source-freshness.mjs",
    "compile:skills": "node scripts/compile-skills.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "lint:agent": "node scripts/lint-agent-readiness.mjs",
    "lint:tables": "node scripts/lint-tables.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "lint:annexure": "node scripts/lint-annexure.mjs",
    "build:routes": "node scripts/build-atom-routes.mjs",
    "check:routes": "node scripts/build-atom-routes.mjs --check",
    "build:widget": "npm run build --workspace widget",
    "test:widget": "npm test --workspace widget",
    "eval:askai:run": "cd mcp && go run ./cmd/askai-eval run -cases ../evals/askai/cases -out ../evals/askai/runs/$(date +%Y-%m-%d)-$(cat ../catalogue/VERSION)",
    "eval:askai:check": "cd mcp && go run ./cmd/askai-eval check -cases ../evals/askai/cases",
    "eval:askai:judge": "cd mcp && go run ./cmd/askai-eval judge -cases ../evals/askai/cases",
    "eval:askai:report": "cd mcp && go run ./cmd/askai-eval report -cases ../evals/askai/cases",
    "eval:askai:calibrate": "cd mcp && go run ./cmd/askai-eval calibrate"
  },
  "devDependencies": {
    "@docusaurus/faster": "^3.10.2",
    "@stoplight/spectral-cli": "^6.11.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react-dom": "^19.2.5",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.62.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
